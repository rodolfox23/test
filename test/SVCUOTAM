#####################################################################
!IF $D(allmacs) = FALSE |THEN|
#
#   Define any macros you want to change from their standard
#   values here
#
!include =allmacs
!include =satmacs
!ENDIF


#---------------------------------
#  EXTERNALS                     -
#---------------------------------
$(server_cuotas_e) : $(server_cuotas_s)
$(genfwd) /in $(server_cuotas_s), out $S.#scuota.ext/ ext $(server_cuotas_e)


#---------------------------------
#  COMPILES                      -
#---------------------------------
 $(server_cuotas_o) : [                     \
 $(basrc_baddltal) ]  $(baddl_ddlbcnst)     \
                      $(okafm_afmsvtg)      \
                      $(okddl_okdt)         \
                      $(oklib_oklibte)      \
                      $(oklib_oklibtg)      \
                      $(basrc_bautile)      \
                      $(aciutils_utilexts)  \
                      $(server_cuotas_e)    \
                      $(server_cuotas_s)    \
                      $(server_cuotas_g)    \
                      $(rdebug_dumpext)     \
                      $(okddl_okdt)         \
                      $(spannet_globals)    \
                      $(spannet_initlibs)   \
                      $(spannet_skel)       \
                      $(spannet_skelexts)   \
                      $(oksrc_oktg)         \
                      $(system_extdecs0)    \
                      $(system_sysmsgs)

    $(TACL)/INLINE/
= $(tacl_init) $(make_tacl_macros)
=
= $(TAL) /IN $(server_cuotas_s), OUT $s.#scuota.tal   &
=        / $(server_cuotas_o);  INSPECT,SYMBOLS
=


#------------------------
#   BIND                -
#------------------------
   $(server_cuotas_b)     :   $(aciutils_utilb)        \
                              $(basrc_bautil)          \
                              $(rdebug_dumplibb)       \
                              $(oklib_oklibto)         \
                              $(spannet_skelb)

   $(TACL)/INLINE/
= $(tacl_init) $(make_tacl_macros)

= #PUSH    :var
= #APPEND  :var add * from $(server_cuotas_o),  delete
= #APPEND  :var select search $(OKLIB_OKLIBTO)
= #APPEND  :var select search $(BASRC_BAUTIL)
= #APPEND  :var select search $(RDEBUG_DUMPLIBB)
= #APPEND  :var select search $(spannet_skelb)
= #APPEND  :var select search $(ACIUTILS_UTILB)
= #APPEND  :var set data 64
= #APPEND  :var select list * off
= #APPEND  :var build $(server_cuotas_b) !

= $(BIND)/ inv :var, out $s.#scuota.bnd/
=
= #POP     :var

 #---------------------
 #   Accelerate       -
 #---------------------

= OCAX / out $s.#scuota.oca/ &
=    $(server_cuotas_b), &
=    OUTPUT_FILE $(server_cuotas_axl), &
=    OBEY $(basrc_ocaxobey), &
=    IGNORE_IR7 GGS_COMPRESS_BUF

= $(BIND) change highrequesters on in $(server_cuotas_axl)
= $(BIND) change highpin on in $(server_cuotas_axl)
