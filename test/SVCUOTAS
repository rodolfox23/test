      ptr^text ':=' "Promocion no registrada en archivo de log: "
                      & log.tipo for 62;
      len^ems   :=  110;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;

  17 ->
      begin
