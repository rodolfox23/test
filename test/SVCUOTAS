!********************************************************************!
!*                                                                  *!
!*  Carga las fichas en la tabla de memoria                         *!
!*                                                                  *!
!********************************************************************!
int proc carga^fichas;
begin

int  contador := -1,
     key^len  := 0,
     k := 0,
     j := 0,
     leidos,
     eof      := FALSE;

int    .temp[0:24];

string .key^term[0:17];



key^term[0] ':=' " " & key^term[0] for 17;  !para que quede en inicio!

call keyposition(fcb.ficha^file^num, key^term, , key^len, 0);
if <> then
   return TRUE;

adm^promo.no^existe^promo := FALSE;
adm^promo.existe^emisor := FALSE;
adm^promo.existe^comercio := FALSE;
adm^promo.num^emisor := 0;
adm^promo.num^comercio := 0;
adm^promo.indice^emisor := 0;


by^default.bin.vector[0] ':=' [ 75  * [0]];
vec^in.bin.vector[0]     ':=' [ 75  * [0]];
vec^ex.bin.vector[0]     ':=' [ 75  * [0]];
vec^td.bin.vector[0]     ':=' [ 75  * [0]];

while (contador := contador + 1) < 401 and not eof do
   begin
   temp[0] ':=' "  " & temp[0] for 24;
   leidos := 0;

   cont^lote := cont^lote + 1F;
   if cont^lote = lote then
      begin
      call delay(tiempo);
      cont^lote := 0F;
      end;


   call read(fcb.ficha^file^num, temp, 50, leidos);
   if <> then
      begin
      call fileinfo(fcb.ficha^file^num, leidos);
      if leidos = 1 then
         eof := TRUE
      else
         return TRUE;

      if contador = 0 then
         !archivo vacio, (no existen promos)!
         !segun definicion dada por Alonso Matteo 16/02/2009 el server!
         !debe continuar rechazando todas las consultas!
         begin
         adm^promo.no^existe^promo := TRUE;
         return FALSE; !no problem!
         end;
      end
   else
      begin

      if contador < 400 and (contador + 1) = temp[9] then
         begin
         t^fichas[contador] ':=' temp[0] for 25 elements;

         !Convertidor Server-Cuotas validó el contenido de los campos!

         if not adm^promo.existe^emisor                    and
            ( t^fichas[contador].tipo^promo.byte[0] = "PA" or
              t^fichas[contador].tipo^promo.byte[0] = "PB" or
              t^fichas[contador].tipo^promo.byte[0] = "PC" ) then
            adm^promo.existe^emisor := TRUE;

         if t^fichas[contador].tipo^promo.byte[0] = "PD" and
            not adm^promo.existe^comercio                then
            begin
            adm^promo.existe^comercio := TRUE;
            if not adm^promo.existe^emisor then
               adm^promo.indice^emisor := 0
            else
               adm^promo.indice^emisor := contador -1;
            adm^promo.num^emisor := contador;
            end;

         k := $dbl(contador) '/' 16;
         j := $dbl(contador) '\' 16;

         if t^fichas[contador].bin = "0"  or
            t^fichas[contador].bin = "2"  then
            begin
            if not pinta(by^default.bin.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rut = "0"  or
            t^fichas[contador].rut = "2"  then
            begin
            if not pinta(by^default.rut.vector[k], j, 1) then
                return TRUE;
            end;


         if t^fichas[contador].rubro = "0"  or
            t^fichas[contador].rubro = "2"  then
            begin
            if not pinta(by^default.rubro.vector[k], j, 1) then
                return TRUE;
            end;


         if t^fichas[contador].bin = "1"  then
            begin
            if not pinta(vec^in.bin.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rut = "1"  then
            begin
            if not pinta(vec^in.rut.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rubro = "1"  then
            begin
            if not pinta(vec^in.rubro.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].bin = "2"  then
            begin
            if not pinta(vec^ex.bin.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rut = "2"  then
            begin
            if not pinta(vec^ex.rut.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rubro = "2"  then
            begin
            if not pinta(vec^ex.rubro.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].bin = "0"  then
            begin
            if not pinta(vec^td.bin.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rut = "0"  then
            begin
            if not pinta(vec^td.rut.vector[k], j, 1) then
                return TRUE;
            end;

         if t^fichas[contador].rubro = "0"  then
            begin
            if not pinta(vec^td.rubro.vector[k], j, 1) then
                return TRUE;
            end;


         end
      else
         !se detectan más de 400 promociones -> error critico!
         !se detecta que la posicion en archivo no cuadra con ID_Interno!
         return TRUE;

      end;

   end; !del while!


if adm^promo.existe^emisor and adm^promo.existe^comercio then
   adm^promo.num^comercio := contador - 1 - adm^promo.num^emisor;

If adm^promo.existe^emisor and not adm^promo.existe^comercio then
   begin
   adm^promo.num^emisor := contador -1;
   adm^promo.indice^emisor := contador -2;
   end;

If not adm^promo.existe^emisor and adm^promo.existe^comercio then
   adm^promo.num^comercio := contador -1;

if contador >= 320 then
   call log^utility( 5, false );


call close(fcb.ficha^file^num);
fcb.ficha^file^num := -1;


return FALSE; !no problems!

end;



