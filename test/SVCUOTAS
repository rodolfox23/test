         ptr^text[80] ':=' "Valor cuota: " & msg_fm.respuesta.valor^cuota
                                              for 12;
         len^ems :=  110;
         end;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;


  13 ->
      begin
      ptr^text ':=' "Problemas al responder el mensaje.";
      len^ems   :=  35;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;


  14 ->
      begin
      ptr^text ':=' "Transaccion sin promocion.";
      len^ems   :=  26;
      if $param(msg) then
         begin
         @msg_fm := @msg;
         ptr^text[27] ':=' "Tarjeta: " & msg_fm.pan for 19;
         len^ems :=  55;
         end;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;


  15 ->
