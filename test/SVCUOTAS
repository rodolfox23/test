   return false;

if not (num.cuotas <> 0 and num.amount > 0F) then
   return false;

return true;
end;


?page   "subproc valida^monto"
int subproc valida^monto(amt, amt1, amt2, accion);
fixed  .amt;
fixed  .ext amt1,
       .ext amt2;
string .ext accion;

begin

if accion = "0" then
   return TRUE;

if accion = "2" then
   begin
   if amt1 <= amt then
      return TRUE
   else
      return FALSE;
   end;

if accion = "1" then
   begin
   if amt1 >= amt then
      return TRUE
   else
      return FALSE;
   end;

if accion = "3" then
   begin
   if amt1 <= amt and amt2 >= amt then
      return TRUE
   else
      return FALSE;
   end;

if accion = "4" then
   begin
   if amt1 = amt then
      return TRUE
   else
      return FALSE;
   end;

return FALSE;
end;



?page   "subproc valida"
int subproc valida(vector, emisor, comercio);
int .ext vector,
    .emisor,
    .comercio;

begin

int j := 0,
    k := 0;


if emisor or comercio then
   begin
   k := $dbl(adm^promo.indice^emisor) '/' 16;
   j := $dbl(adm^promo.indice^emisor) '\' 16;
   end
else
   return FALSE;


if emisor then
   begin
   if k <> 0 then
      begin
      if vector[0] = cero for k words then
         begin
         if c^rango(vector[k], j, 0) then
            begin
            emisor := FALSE;
            end;
         end;
      end
   else
      begin
      if c^rango(vector[k], j, 0) then
         emisor := FALSE;
      end;
   end; !de emisor!

if comercio then
   begin
   if vector[k + 1] = cero for (24 - k) words then
      begin
      if j = 15 then
         begin
         comercio := FALSE;
         return TRUE;
         end
      else
         begin
! Inicio RPQ: #001!
         if adm^promo.indice^emisor <> 0  and
            c^rango( vector[k], j + 1, 1) then
            begin
            comercio := FALSE;
            return TRUE;
            end
         else
            if adm^promo.indice^emisor = 0   and
               c^rango( vector[k], j, 1)     then
               begin
               comercio := FALSE;
               return TRUE;
               end
            else
               return FALSE;
! Fin RPQ: #001!
         end;
      end
   else
      return FALSE;
   end; !de comercio!

end; !de valida!


