                    " respaldo. El Server-Cuotas se ha quedado sin input.";
      len^ems   :=  102;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;


   otherwise ->
      begin
      ptr^text ':=' "Numero de mensaje desconocido.";
      len^ems   :=  16;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;
   end;

if $param( abnd ) and abnd then
   begin
   ptr^text ':=' " " & ptr^text[0] for 399;
   ptr^text ':=' "El server-cuotas se detendra!!!! ";
   len^ems   :=  34;
   alarm := 1;
   error := write^ems( evnt_msg, pl, len^ems, alarm);

   !cierro todos los archivos y stop!
   call cierra^archivos(3, true);
   end;

end;  !  proc log^utility  !



?section write^ems
?page "***** write^ems *****"
!************************************************************************!
!*  PROCEDIMIENTO QUE ENVIA MENSAJES AL COLECTOR                        *!
!*                                                                      *!
!*                                                                      *!
!*  PARAMETROS:                                                         *!
!*                                                                      *!
!*    error^cde    : Nº del error.                                      *!
!*    error^msg    : Mensaje en un buffer tipo INT.                     *!
!*    error^msg^len: Largo del mensaje en bytes.                        *!
!*    critico      : Valor 0    -> normal.                              *!
!*                   Valor 1    -> critico.                             *!
!*                                                                      *!
!*                                                                      *!
!*                                                                      *!
!*  RESPUESTAS:                                                         *!
!*    0 -> OK.                                                          *!
!*    1 -> LARGO DE BUFFER.                                             *!
!*    2 -> VALOR INVALIDO PARA PARAMETRO CRITICO.                       *!
!*    3 -> ERROR AL ABRIR COLECTOR.                                     *!
!*    4 -> ERROR AL INICIALIZAR BUFFER.                                 *!
!*    5 -> ERROR AL INCORPORAR TOKENS.                                  *!
!*                                                                      *!
!*                                                                      *!
!************************************************************************!

int proc write^ems( error^cde, error^msg, error^msg^len, critico);

int  error^cde;
int .error^msg;
int  error^msg^len;
int  critico;
begin

struct .ext ems^ssid(zems^val^ssid^def);
struct .ext our^ssid(zspi^val^ssid^def);

int  colector := 0,
     error := 0,
     value,
     value2,
     event^size := 0;

string .ext asunto[0:11];


subproc inicializar;
   begin
   value  := 0;
   value2 := 0;
   asunto ':=' "SERVER CUOTA";
   evt^msg^buff.z^msgcode := 0;
   evt^msg^buff.z^buflen  := 0;
   evt^msg^buff.z^occurs  := 0;
   end;

if error^msg^len > 200 then
   return 1;

if critico <> 1 and critico <> 0 then
   return 2;


call inicializar;

