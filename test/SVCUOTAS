?section carga^bin
?page "carga^bin"
!********************************************************************!
!*                                                                  *!
!*  Carga la información del archivo BIN                            *!
!*                                                                  *!
!********************************************************************!
int proc carga^bin;
begin

int  leidos,
     key^len  := 0,
     hash^id  := -1,
     i        := 0,
     k        := -1,
     j        := -1,
     error    := 0,
     eof      := FALSE;

string  .key^term[0:11] := [ 12 * [" "]];

int     .temp[0:406],
        .vec^temp1[0:24],
        .vec^temp2[0:24],
        .ptrt(reg^bin^def) := @temp[0],
    .ext p^nodo(nodo2),
    .ext p^nodo^t(nodo2^t);

int(32) dir := -1D;



for i := 0 to 807 do
   begin
   @hash^bin[i].ptr^dir := 0D;
   end;

call keyposition(fcb.bines^file^num, key^term, , key^len, 0);
if <> then
   !imposible posicionar -> seria todo!
   return TRUE;

while not eof do
   begin
   temp[0] ':=' "  " & temp[0] for 405 words;
   leidos := 0;

   cont^lote := cont^lote + 1F;
   if cont^lote = lote then
      begin
      call delay(tiempo);
      cont^lote := 0F;
      end;

   call read(fcb.bines^file^num, temp, 814, leidos);
   if <> then
      begin
      call fileinfo(fcb.bines^file^num, leidos);
      if leidos = 1 then
         eof := TRUE
      else
         return TRUE;
      end
   else
      begin
      if not H1(ptrt.id^bin, 1, hash^id) then
         return TRUE;

      if @hash^bin[hash^id].ptr^dir = 0D then
         begin
         if crea^espacio(66D, dir) then
            begin
            @hash^bin[hash^id].ptr^dir := dir;
            @p^nodo := dir;
            end
         else
            return TRUE;
         end !de asignacio directa!
      else
         begin
         @p^nodo := @hash^bin[hash^id].ptr^dir;
         if not H2(ptrt.id^bin, 1, hash^id) then
            return TRUE;

         if @p^nodo.ptr^next = 0D then
            begin
            if crea^espacio(44D, dir) then
               begin
               @p^nodo.ptr^next := dir;
               @p^nodo^t := dir;
               for i := 0 to 10 do
                  begin
                  @p^nodo^t.t^rehash[i].ptr^dir := 0D;
                  end;
               dir := -1D;
               if crea^espacio(66D, dir) then
                  begin
                  @p^nodo^t.t^rehash[hash^id].ptr^dir := dir;
                  @p^nodo := dir;
                  end
               else
                  return TRUE;
               end
            else
               return TRUE;

            end
         else
            begin
            @p^nodo^t := @p^nodo.ptr^next;
            if @p^nodo^t.t^rehash[hash^id].ptr^dir = 0D then
               begin
               if crea^espacio(66D, dir) then
                  begin
                  @p^nodo^t.t^rehash[hash^id].ptr^dir := dir;
                  @p^nodo := dir;
                  end
               else
                  return TRUE;
               end
            else
               begin
               @p^nodo := @p^nodo^t.t^rehash[hash^id].ptr^dir;
               while @p^nodo.ptr^next <> 0D do
                  begin
                  @p^nodo := @p^nodo.ptr^next;
                  end;

               if crea^espacio(66D, dir) then
                  begin
                  @p^nodo.ptr^next := dir;
                  @p^nodo := dir;
                  end
               else
                  return TRUE;
               end;
            end; ! de segunda colision!
         end; ! colision detectada!

      p^nodo.bin ':=' ptrt.id^bin for 11;
      p^nodo.colision ':=' " ";

      p^nodo.vector[0] ':=' [25 * [0]];
      for i := 0 to (ptrt.cant^promo -1) do
         begin
         if ptrt.promo[i].id^interno < 1 or
            ptrt.promo[i].id^interno > 400 then
            return TRUE;
         if ptrt.promo[i].id^interno > adm^promo.num^emisor then
            return TRUE;
         k := $dbl(ptrt.promo[i].id^interno - 1) '/' 16;
         j := $dbl(ptrt.promo[i].id^interno - 1) '\' 16;
         if not pinta(p^nodo.vector[k], j, 1) then
            return TRUE;
         end;

      k := $dbl(adm^promo.indice^emisor) '/' 16;
      vec^temp1[0] ':=' [ 25 * [0]];
      vec^temp2[0] ':=' [ 25 * [0]];
      for i := 0 to k do
         begin
         vec^temp1[i] := p^nodo.vector[i] LAND vec^in.bin.vector[i];
         vec^temp2[i] := p^nodo.vector[i] XOR  vec^ex.bin.vector[i];
         vec^temp2[i] := vec^temp2[i] LAND vec^ex.bin.vector[i];
         p^nodo.vector[i] := vec^temp1[i] XOR vec^temp2[i];
         p^nodo.vector[i] := p^nodo.vector[i] XOR vec^td.bin.vector[i];
         end;

      @p^nodo.ptr^next := 0D;
      end; !de lectura!

   end; !del while!


call close(fcb.bines^file^num);
fcb.bines^file^num := -1;


return FALSE; !no problems!

end;





