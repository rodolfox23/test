!****************************************************************!
!*                                                              *!
!*  Funcion de hash utilizada para BIN, RUBRO, RUT.             *!
!*                                                              *!
!****************************************************************!
int proc H1(key, tipo, hash^id);
string .ext key;
int         tipo;
int        .hash^id;
begin

fixed .ext valor[0:1];

int      len  := 0,
         base := 0;


case tipo of
   begin
   1 ->  !BIN!
      begin
      base := 809;
      len  := 11;
      end;!de 1->!
   2 ->  !RUBRO!
      begin
      base := 599;
      len  := 3;
      end;!de 2->!
   3 ->  !RUT!
      begin
      base := 2999;
      len  := 9;
      end;!de 3->!
   otherwise ->
      begin
      return FALSE;
      end;
   end; !de case!

valor[0] := 0F;
valor[1] := 0F;

if not ascii^fixedx(key, len, valor[0]) then
   return FALSE;

valor[1] := valor[0] / $fix(base);
hash^id := $int(valor[0] - ( valor[1] * $fix(base) ));

return TRUE;
end; !de proc!




?section H2
?page "H2"
!****************************************************************!
!*                                                              *!
!*  Funcion de re-hash utilizada para BIN, RUBRO, RUT.          *!
!*                                                              *!
!****************************************************************!
int proc H2(key, tipo, hash^id);
string .ext key;
int         tipo;
int        .hash^id;
begin

fixed .ext valor[0:1];
fixed(3) .ext resto[0:0];

int      len  := 0,
         base := 0,
         id   := 0;

case tipo of
   begin
   1 ->  !BIN!
      begin
      base := 11;
      len  := 11;
      end;!de 1->!
   2 ->  !RUBRO!
      begin
      base := 11;
      len  := 3;
      end;!de 2->!
   3 ->  !RUT!
      begin
      base := 11;
      len  := 9;
      end;!de 3->!
   otherwise ->
      begin
      return FALSE;
      end;
   end; !de case!


valor[0] := 0F;
valor[1] := 0F;
resto[0] := 0F;

if not ascii^fixedx(key, len, valor[0]) then
   return FALSE;

valor[1] := valor[0] * 0.618F;
resto[0] := valor[0] * 0.618F;
valor[1] := (((resto[0] - valor[1]) / 1F) * $fix(base));
hash^id := $int(valor[1]);

return TRUE;
end; !de proc!


?section get^init^params
?page "***** get^init^params *****"
!*********************************************************************!
!*                                                                   *!
!*                          get^init^params                          *!
!*                                                                   *!
!*********************************************************************!
proc get^init^params;

begin
literal
                abort    = 1,
                no^abort = 0;

struct
               .lconf( lconf^def );

int
                buf^len,
                i,
                status,
                error,
                text^len;

string
               .buf^s[ 0:79 ],
               .error^text1[ 0:16 ],
               .error^text2[ 0:15 ],
               .text[ 0:79 ];

string
                base^param^table = 'P' := [
                    "SERVER-LOTE                     ", no^abort, ! 00!
                    "SERVER-DELAY                    ", no^abort, ! 01!
                    "SERVER-TRACE-ON                 ", no^abort, ! 02!
                                                       0 ];

define
                base^param^name( index ) =
                    base^param^table[ ( ( index ) * 33 ) ] #,
                base^abort^flag( index ) =
                    base^param^table[ ( ( index ) * 33 ) + 32 ] #;

!*********************************************************************!
!*                        lconf^read^                                *!
!*********************************************************************!
int subproc lconf^read^( abort^run );
int             abort^run;

begin
if ( error := lconf^read( fcb.lconf^file^num, lconf,
                                lconf.prikey,,,,, buf^s,
                                buf^len ) ) then
    begin
    call log^utility(4, true, error);
    return false;
    end;

return true;
end;

lconf.prikey.item^typ ':=' "P";
lconf.prikey.pro^name ':=' [ $len( lconf.prikey.pro^name )* [ "*" ] ];

i := -1;
while base^param^name( i := i + 1 ) do
    begin
    lconf.prikey.item^name ':=' base^param^name( i ) for
                              $len( lconf.prikey.item^name );
    if lconf^read^( base^abort^flag( i ) ) then
        begin
        text    ':=' " " & text for 69;
        text^len :=  lconf.param^msg.plgth;
        text    ':=' lconf.param^msg.ptxt for text^len;
        call shiftstring( text, text^len, 0 );
        case i of
            begin
            !00! begin   ! lote !
                 if not ascii^fixed( text, text^len, lote) then
                    begin
                    call log^utility( 4, true);
                    end;
                 end;
            !01! begin   ! delay !
                 if not ascii^double( text, text^len, tiempo ) then
                     begin
                     call log^utility( 4, true);
                     end;
                 end;
            !02! begin   ! TRACE ON!
                 call remove^blanks( text, text^len );
                 if text = "Y" then
                     begin
                     trace^on := true;
                     end;
                 end;
            !??! otherwise
                    begin
                    call log^utility( 4, true);
                    end;
            end;
        end;
    end;
end;
