int subproc calcula^cuota(cuota);
string .cuota;

begin

!Inicio RPQ:#2-3!

!num.valor^cuota := num.amount / $fix(num.cuotas);
num.valor^cuota := num.amount * 100F / $fix(num.cuotas);

!Fin RPQ: #2-3!

if not fixed^ascii( cuota, 12, num.valor^cuota ) then
   return false;

return true;
end;





?page   "subproc transforma"
int subproc transforma(amt, ncuota);
string .amt,
       .ncuota;

begin

num.amount       := 0F;
num.cuotas       := 0;
num.valor^cuota  := 0F;

if not ascii^fixed ( amt, 12, num.amount ) then
   return false;

!Inicio RPQ: #2-3!

