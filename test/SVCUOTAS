!#####################################################################!
!#                                                                   #!
!#                        server^cuotas MAIN                         #!
!#                        ------------------                         #!
!#                                                                   #!
!#####################################################################!
proc server^cuotas main;
begin

int      .msg[ 0:( ( max_msg_lgth_l + 1 )/2 ) - 1 ],
          continue := FALSE,
          resp     := 0,
          stat     := 0;


!proceso general de inicializacion!
call inicializa( msg);
call log^utility( 7, false );
continue := lee^receive(msg);

while continue do
   begin
   stat := espera^receive;
   case stat of
      begin
      0 ->  !txn!
         begin
         if trace^on then
            call log^utility(6, false, 1, , ,msg);

         if not adm^promo.no^existe^promo then
            resp := requerimiento( msg)
         else
            !este caso se da cuando en los archivos de novedades no!
            !se informan promociones!
            resp := 2;

         case resp of
            begin
            1 ->
               begin
               !se detecta promocion!
               if trace^on then
                  call log^utility(6, false, 0, , ,msg);
               end;
            2 ->
               begin
               !la txn no posee promocion!
               if trace^on then
                  call log^utility(6, false, 0, , ,msg);
               end;
            otherwise ->
               begin
               !requerimiento con error!
               call log^utility(2, false);
               if trace^on then
                  call log^utility(6, false, 0, , ,msg);
               end;
            end;

         resp := 0;
         resp := file_getreceiveinfo_( receive_info.receive^info);
         if resp then
            begin
            call log^utility( rcvinf_err_l, true );
            end;

         !retengo los valores de comunicacion!
         receive_info.message^tag := receive_info.receive^info.message^tag;
         receive_info.open^label := receive_info.receive^info.open^label;

         !comunica respuesta al requerimiento!
         call reply( msg, cnt_read,, receive_info.message^tag, stat );
         if <> then
            begin
            if < then
               begin
               !problemas en respuesta!
               call log^utility(13, false );
               end;
            end
         else
            begin
            !resulto todo ok -> registro del evento!
            !SOLO SI EXISTE PROMOCION!
            if msg[0] = 1 then
               begin
               call hora^fin;
               if log.fecha <> conf.fecha for 10 then
                  begin
                  !establece fecha para archivo log!
                  call determina^dia;
                  fcb.log^file^num^hold := fcb.log^file^num;

                  if not open^log then
                     begin
                     if not open^log then
                        fcb.log^file^num := fcb.log^file^num^hold
                     else
                        begin
                        call close(fcb.log^file^num^hold);
                        fcb.log^file^num^hold := -1;
                        end;
                     end
                  else
                     begin
                     call close(fcb.log^file^num^hold);
                     fcb.log^file^num^hold := -1;
                     end;
                  end;

               if not registra^evento then
                  begin
                  call log^utility(15, false);
                  end;

               if fcb.log^file^num^hold > 0 then
                  begin
                  !sin nuevo archivo de log -> imposible logear!
                  call log^utility(4,true);
                  call cierra^archivos(3,true);
                  end;
               end;
            end;

         continue := lee^receive(msg);

         end;

      40 ->  !timeout!
         begin
         continue := lee^receive(msg);
         end;

      6 ->
         begin
         continue := mensaje^de^sistema( msg );
         if continue then
            continue := lee^receive(msg);
         end;

      otherwise ->
         begin
         continue := false;
         call log^utility( 4, true, stat );
         end;  !otherwise!

      end;  !case stat of!
   end;  !while continue do!
end;  ! server^cuotas  !


