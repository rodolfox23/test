?section recupera^params
?page "recupera^params"
!#####################################################################!
!#                                                                   #!
!#                      recupera^params                              #!
!#                      ---------------                              #!
!#                                                                   #!
!#####################################################################!
proc recupera^params( rucb, passthru, parms, msglen, match ) variable;
int      .rucb,
         .passthru( passthru_def ),
         .parms( ci^param ),
          msglen,
          match;

begin
string   .ptr^coll := @conf.colector^name '<<' 1;

int     i,
        asignado,
        parametro,
        parametro_ofst,
        valor,
        valor_ofst,
       .default^names[ 0:7 ] := 8 * ["  "];

string  .local[0:1] := ["  "],
        .temporal[0:35];

define  lconf_d        =  "LCONF"#,
        coll_d         =  "COLECTOR"#,
        red_d          =  "RED"#;


if ( msglen < $offset( parms.parameters ) ) or
   ( parms.msgcode <> ci^param^msgcode    ) then
   begin
   call log^utility( 6, true );
   end;


if parms.numparams > 0 then
   begin
   i              := -1;
   asignado       := 0;
   parametro_ofst := 0;
   valor_ofst     := 0;
   parametro      := 0;
   valor          := 0;
   ptr^coll         ':=' " " & ptr^coll[0] for 23;



   while ( ( i := i + 1 ) < parms.numparams ) do
      begin
      parametro.<8:15> := parms.parameters[ parametro_ofst ];
      valor_ofst   := parametro_ofst + 1 + parametro;
      valor.<8:15> := parms.parameters[ valor_ofst ];

      if parms.parameters[parametro_ofst +1] = lconf_d then
         begin
         temporal ':=' " " & temporal[0] for 35;
         temporal ':=' parms.parameters[valor_ofst +1] for valor;
         if fnameexpand( temporal, fcb.lconf^file, default^names) then
            asignado := asignado +1;
         end
      else
      if parms.parameters[parametro_ofst +1] = red_d then
         begin
         conf.red^text[0] ':=' " " & conf.red^text[0] for 5;
         conf.red^text[0] ':=' parms.parameters[valor_ofst +1] for valor;
         conf.red^len := valor;
         if conf.red^len < 7 then
            asignado := asignado +1;
         end
      else
      if parms.parameters[parametro_ofst +1] = coll_d then
         begin
         if valor > 24 then !trunca el parametro!
            valor := 24;

         ptr^coll ':=' parms.parameters[valor_ofst +1] for valor;
         asignado := asignado +1;
         end;
      parametro_ofst := valor_ofst + 1 + valor;
      end; ! of while!
   end
else   ! no existen parametros, stop !
   call log^utility( 6, true );

if asignado <> 3 then  ! faltan parametros !
   call log^utility( 6, true );

end;  !  recupera^params  !




