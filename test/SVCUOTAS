      evt^msg^buff.z^filler ':=' ["SCUOTAS "];

      if not ( error := emsaddtokens(  evt^msg^buff,  !buffer!
                                           ems^ssid,  !ssid!
                                  zems^tkn^emphasis,  !tknid!
                                              value,  !emphasis!
                                                   ,
