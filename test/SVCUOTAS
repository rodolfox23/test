!#####################################################################!
!#                                                                   #!
!#                      mensaje^de^sistema                           #!
!#                      ------------------                           #!
!#                                                                   #!
!#####################################################################!
int proc mensaje^de^sistema( buffer );
int      .buffer;

begin

int   err := 0,
     .resp[0:1];


?page "mensaje^de^sistema"

err := file_getreceiveinfo_( receive_info.receive^info );
if err then
   begin
   call log^utility( rcvinf_err_l, true );
   end;

receive_info.message^tag :=  receive_info.receive^info.message^tag;
receive_info.open^label  :=  receive_info.receive^info.open^label;

case $abs( buffer[ 0 ] ) - 103 of
   begin
   !-103!  begin
           ! open system msg !
           buffer[0] := -103;

           if not receive_info.open^track then
              begin
              receive_info.open^track := true;
              receive_info.open^count := receive_info.open^count + 1;
              buffer[1] := receive_info.open^label + 1;

              call reply(buffer, 4, ,receive_info.message^tag, 0 );
              if <> then
                 call log^utility( rcvinf_err_l, true );

              end
           else
              begin
              buffer[1] := 0;
              call reply(buffer, 4, ,receive_info.message^tag, 10 );
              if <> then
                 call log^utility( rcvinf_err_l, true );
              end;
           end;

   !-104!  begin
           ! close system msg !
           if receive_info.open^track then
              begin
              receive_info.open^track := false;
              receive_info.open^count := receive_info.open^count - 1;
              end;

           !  Reply to system msg  !
           call reply(,,, receive_info.message^tag, 0);
           if <> then
              begin
              call log^utility( rcvinf_err_l, true );
              end;

           if receive_info.open^count <= 0 then
              begin
              call log^utility(8, false);
              call cierra^archivos(3, true);
              return false;
              end;
           end;

   ! ???!  otherwise
           begin
           call reply(,,, receive_info.message^tag, 2 );
           if <> then
              call log^utility( rcvinf_err_l, true );
           end;
   end;

return true;

end; ! mensaje^de^sistema !



