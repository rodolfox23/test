         end;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;

   7 ->
      begin
      ptr^text ':=' "SERVER-CUOTAS inicializado exitosamente.";
      len^ems   :=  42;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;

   8 ->
      begin
      ptr^text ':=' "SERVER-CUOTAS detenido!!!.";
      len^ems   :=  26;
      alarm     :=  1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;

  10 ->
      begin
      ptr^text ':=' "Entrada no valida para tabla de servers.";
      len^ems   :=  40;
      alarm := 1;
      error := write^ems( evnt_msg, pl, len^ems, alarm);
      end;


  11 ->
