--canal

AU_OPEN_TRANSACTION.ID_MESSAGE_CHANNEL

--mti

AU_OPEN_TRANSACTION.MTI_CODE

--tipo

AU_OPEN_TRANSACTION.TRANSACTION_CATEGORY

AU_OPEN_TRANSACTION.TRANSACTION_TYPE

 

--marca

AUA_TRX_ACQUIRING_DATA.ID_BRAND

AUA_TRX_ACQUIRING_DATA.ID_TRANSACTION_PROFILE

--tipo de transacción

 

