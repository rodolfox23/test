export const parsePaymentDate = (
  value: string | null | undefined,
): Date | null => {
  if (!value) {
    return null;
  }

  const parts = value.split('-');
  if (parts.length !== 3) {
    return null;
  }

  const [first, month, last] = parts;
  const [year, day] = first.length === 4 ? [first, last] : [last, first];
  const parsed = new Date(Number(year), Number(month) - 1, Number(day));

  return Number.isNaN(parsed.getTime()) ? null : parsed;
};

export const formatValue = (value: string | number | null | undefined) => {
  if (value === null || value === undefined || value === '') {
    return '--';
  }

  return String(value);
};

export const formatDate = (value: string | null | undefined, tab = '/') => {
  if (!value || value === '-') {
    return '--';
  }

  const parts = value.split('-');
  if (parts.length !== 3) {
    return value;
  }

  const [first, month, last] = parts;
  // El backend entrega DD-MM-YYYY, pero los mocks usan YYYY-MM-DD.
  const [year, day] = first.length === 4 ? [first, last] : [last, first];
  if (!year || !month || !day) {
    return value;
  }

  return `${day}${tab}${month}${tab}${year}`;
};

export const formatPensionAmount = (
  value: string | number | null | undefined,
) => {
  if (value === null || value === undefined || value === '') {
    return '--';
  }

  const raw = String(value).trim();
  // El separador decimal puede ser ',' (backend CL) o '.' (mocks).
  const match = raw.match(/^(-?\d+)(?:[.,](\d+))?$/);
  if (!match) {
    return raw;
  }

  const [, integerPart, decimals = ''] = match;
  // Truncar a 2 decimales por slice — sin aproximar.
  const truncatedDecimals = decimals.slice(0, 2).padEnd(2, '0');

  return `${integerPart},${truncatedDecimals} UF`;
};

export const formatPersonName = (value: string | null | undefined) => {
  if (!value || value.trim().length === 0) {
    return '--';
  }

  return value.trim().toLowerCase().split(/\s+/).map(capitalize).join(' ');
};

export const capitalize = (str: string) =>
  str.charAt(0).toUpperCase() + str.slice(1);

export const isMissing = (value: string | number | null | undefined) =>
  value === null ||
  value === undefined ||
  value === '' ||
  value === '--' ||
  value === '-';
